# Back end (definir como variables de entorno antes de iniciar uvicorn)
FIREBASE_KEY_PATH=serviceAccountKey.json
# Dominio del front end publicado (además de localhost:5173), separados por coma
ALLOWED_ORIGIN=https://surgeron.github.io
# 1 = consulta el pronóstico cada hora; 0 = solo a pedido y carga manual
PRONOSTICO_AUTOMATICO=1
# Clave de los 4 usuarios de prueba que crea el script de carga (mínimo 6 caracteres)
SEED_PASSWORD=
# Tiempo de vida de la caché en segundos (las escrituras del back end la invalidan al instante)
CACHE_TTL_SEGUNDOS=1800
